{
  "name": "oms-pandemic-dashboard",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "axios": "^1.10.0",
    "chart.js": "^4.5.0",
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "^5.0.1",
    "react-simple-maps": "^3.0.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "build": "react-app-rewired build",
    "cy:open": "cross-env CYPRESS_COVERAGE=1 cypress open",
    "cy:run": "cross-env CYPRESS_COVERAGE=1 cypress run",
    "coverage:report": "nyc report --reporter=html"
  },
  "nyc": {
    "exclude": [
      "**/reportWebVitals.ts"
    ],
    "reporter": [
      "text",
      "html"
    ],
    "all": true,
    "extension": [
      ".ts",
      ".tsx"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.5",
    "@types/react-simple-maps": "^3.0.6",
    "babel-plugin-istanbul": "^7.0.0",
    "cross-env": "^7.0.3",
    "customize-cra": "^1.0.0",
    "cypress": "^14.5.0",
    "istanbul-lib-coverage": "^3.2.2",
    "nyc": "^17.1.0",
    "react-app-rewired": "^2.2.1",
    "start-server-and-test": "^2.0.12"
  }
}
